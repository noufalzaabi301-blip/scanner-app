# Copy this file to .env and fill in your own values.
# Only PUBLISHABLE (public) Supabase keys belong here. Never put a
# service-role / secret key in this file or anywhere in the app.

# User database (accounts, preferences, Avoid List, submissions)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_KEY=

# Food database (approved products, read-only)
EXPO_PUBLIC_PRODUCT_SUPABASE_URL=
EXPO_PUBLIC_PRODUCT_SUPABASE_KEY=
